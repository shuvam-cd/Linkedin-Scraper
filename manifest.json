{
  "manifest_version": 3,
  "name": "LinkedIn Scraper By Sumon",
  "version": "1.0.5",
  "description": "Collect a LinkedIn profile and its posts using your own already-logged-in browser session. Conservatively paced, visible tab, one ZIP export with CSV.",

  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "activeTab",
    "unlimitedStorage",
    "offscreen"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.licdn.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Scraper By Sumon",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["utils.js", "voyager.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
